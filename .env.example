# AgentVendi Environment Configuration
PORT=3001

# Database Configuration
# Options: 'sqlite' or 'postgresql'
DB_TYPE=sqlite
DATABASE_URL=postgres://postgres:password@localhost:5432/agentvendi
SQLITE_DB_PATH=../../data/agentvendi.db

# State Management (Redis)
REDIS_URL=redis://localhost:6379

# Authentication
# IMPORTANT: Change this to a long random secret in production
JWT_SECRET=agentvendi-v1-dev-secret-key-change-me

# Agent Intelligence
OLLAMA_HOST=http://localhost:11434
OPENAI_API_KEY=your-api-key-here

# Security & Limits
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
