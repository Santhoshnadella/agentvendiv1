{
  "name": "agentvendi",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w @agentvendi/frontend\" \"npm run dev -w @agentvendi/backend\"",
    "build": "npm run build --workspaces",
    "migrate": "npm run migrate -w @agentvendi/backend",
    "test": "npm test --workspaces",
    "lint": "npm run lint --workspaces",
    "docker:build": "docker build -t agentvendi .",
    "docker:publish": "echo 'Publishing to GHCR...'"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.5.2",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^10.0.0",
    "@types/winston": "^2.4.4",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.1.0",
    "tsx": "^4.10.1",
    "typescript": "^5.4.5"
  }
}
